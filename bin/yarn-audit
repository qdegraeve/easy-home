#!/usr/bin/env ruby
# yarn audit, with a list of accepted advisories (config/yarn-audit.yml).
# Fails on any unlisted advisory, and on any acceptance past its deadline.
require "date"
require "json"
require "open3"
require "yaml"

config = YAML.safe_load_file(File.expand_path("../config/yarn-audit.yml", __dir__), permitted_classes: [ Date ])
accepted = (config["ignore"] || []).to_h { |entry| [ entry["id"], entry ] }

output, = Open3.capture2("yarn", "audit", "--json")
output.force_encoding(Encoding::UTF_8)
unless output.include?('"type":"auditSummary"')
  warn "yarn audit did not complete:\n#{output}"
  exit 1
end

advisories = output.each_line.filter_map do |line|
  event = JSON.parse(line)
  event["data"]["advisory"] if event["type"] == "auditAdvisory"
rescue JSON::ParserError
  nil
end.uniq { |advisory| advisory["id"] }

failures = []
advisories.each do |advisory|
  label = "#{advisory["module_name"]} (#{advisory["severity"]}, #{advisory["id"]}): " \
          "#{advisory["title"]} #{advisory["url"]}"
  entry = accepted[advisory["id"]]

  if entry.nil?
    failures << "✗ #{label}"
  elsif entry["until"] < Date.today
    failures << "✗ acceptance expired on #{entry["until"]}: #{label}"
  else
    puts "– accepted until #{entry["until"]}: #{label}"
  end
end

(accepted.keys - advisories.map { |advisory| advisory["id"] }).each do |id|
  puts "ℹ #{id} is no longer reported: remove it from config/yarn-audit.yml"
end

if failures.empty?
  puts "✓ yarn audit: no unaccepted vulnerability"
else
  puts failures
  puts "Upgrade the package, or document the acceptance in config/yarn-audit.yml."
  exit 1
end
