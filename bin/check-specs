#!/usr/bin/env bash
# Guardrails on the test suite, run in CI (Lint job) and by bin/ci.
# A reliable spec waits for a state (Capybara matchers), never for a duration.
set -uo pipefail

status=0

check() {
  local message="$1" pattern="$2"
  local hits
  hits=$(grep -rnE "$pattern" spec --include='*.rb' || true)
  if [ -n "$hits" ]; then
    echo "✗ $message"
    echo "$hits"
    echo
    status=1
  fi
}

check "sleep is forbidden: use Capybara waiting matchers (have_content, have_css...) or travel_to" '^[^#]*\bsleep\b'
check "focused spec left behind (fit, fdescribe, fcontext, focus: true)" \
  '^\s*(fit|fdescribe|fcontext|fscenario|ffeature)\b|focus: true'
check "spec retries are forbidden: a flaky spec gets fixed, not rerun" 'rspec-retry|retry_count|:retry\b'
check "Time.now / Date.today are forbidden: use Time.current, Time.zone.today and travel_to" \
  '\b(Time\.now|Date\.today)\b'

if [ "$status" -eq 0 ]; then echo "✓ Spec guardrails: OK"; fi
exit "$status"
