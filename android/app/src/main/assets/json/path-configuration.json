{
  "settings": {},
  "rules": [
    {
      "patterns": [".*"],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": ["/new$", "/edit$"],
      "properties": {
        "context": "modal",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": ["^/$", "/session/new$", "/passwords/new$"],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "presentation": "replace_root",
        "pull_to_refresh_enabled": true
      }
    }
  ]
}
