<div class="flex items-center gap-3 px-3 py-2">
  <span class="<%= class_names("grid size-9 shrink-0 place-items-center rounded-full",
                               task.critical? ? "bg-alert-soft text-alert" : "bg-subtle text-plants") %>">
    <%= helpers.icon(mark_icon) %>
  </span>
  <div class="min-w-0 flex-1 py-1">
    <%# Title and detail are one touch target (44 px together), not a 44 px title above its detail: a shorter row. %>
    <%= content_tag(href ? :a : :div, href: href,
                    class: class_names("block min-h-11", "-mx-1 rounded-lg px-1 active:bg-subtle": href)) do %>
      <span class="block font-medium"><%= title %></span>
      <span class="block text-sm text-muted">
        <%= detail %> · <%= render DueLabelComponent.new(due_at: occurrence.due_at, critical: task.critical?) %>
      </span>
    <% end %>
    <%# Under the text, not beside the round button: on a narrow phone the title keeps its width. %>
    <% if actions? || postpone? %>
      <div class="flex gap-1">
        <%= actions %>
        <% if postpone? %>
          <%= button_to task_occurrence_postponement_path(occurrence), aria: { label: postpone_label },
                class: helpers.chip_class do %>
            <span class="<%= helpers.chip_inner_class %>">
              <%= helpers.icon(:redo_2, size: 16) %><%= t(".postpone_button") %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if done_today %>
    <span class="inline-flex shrink-0 items-center gap-1 text-sm text-muted">
      <%= helpers.icon(:check, size: 16) %><%= done_today_label %>
    </span>
  <% else %>
    <%= button_to task_occurrence_completion_path(occurrence), aria: { label: done_label },
          class: helpers.done_button_class do %>
      <%= helpers.icon(:check, size: 22) %>
    <% end %>
  <% end %>
</div>