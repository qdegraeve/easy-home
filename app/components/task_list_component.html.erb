<%= render ListGroupComponent.new(title:, id:) do |group| %>
  <% critical.each do |occurrence| %>
    <% group.with_row { render(row(occurrence)) } %>
  <% end %>
  <% if waterings.any? %>
    <% group.with_row do %>
      <div class="flex items-center gap-3 px-3 py-2">
        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-subtle text-plants">
          <%= helpers.icon(:droplet) %>
        </span>
        <%= link_to today_watering_path, class: "flex min-h-11 min-w-0 flex-1 flex-col justify-center py-1" do %>
          <span class="font-medium">
            <%= t(".water") %>
            <span class="ml-1 rounded-full bg-subtle px-2 text-sm text-muted"><%= waterings.size %></span>
          </span>
          <span class="text-sm text-muted"><%= watering_places %></span>
        <% end %>
        <%= button_to(
          task_occurrences_batch_completion_path,
          params: { occurrence_ids: waterings.map(&:id) },
          aria: { label: t(".water_all", count: waterings.size) },
          class: helpers.done_button_class
        ) do %>
          <%= helpers.icon(:check, size: 22) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <% others.each do |occurrence| %>
    <% group.with_row { render(row(occurrence)) } %>
  <% end %>
  <% if empty %><%= render EmptyStateComponent.new(text: empty) %><% end %>
<% end %>