<h1 class="text-2xl font-bold" data-screen-title><%= page_title t(".title") %></h1>
<p class="text-sm text-muted"><%= t(".period", count: JournalController::DAYS) %></p>

<div class="mt-6 space-y-6 lg:max-w-2xl">
  <% if @entries.empty? %>
    <%= render EmptyStateComponent.new(icon: :history, text: t(".empty")) %>
  <% end %>

  <% @entries.each do |date, entries| %>
    <% title = l(date, format: :long).upcase_first %>
    <%= render ListGroupComponent.new(title:, id: "day-#{date.iso8601}") do |group| %>
      <% entries.each do |entry| %>
        <% group.with_row { render(JournalEntryComponent.new(entry:, user: Current.user)) } %>
      <% end %>
    <% end %>
  <% end %>
</div>