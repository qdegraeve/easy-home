<h1 class="text-2xl font-bold"><%= page_title t(".title") %></h1>
<p class="text-sm text-muted"><%= t(".period", count: JournalController::DAYS) %></p>

<div class="mt-6 space-y-6 lg:max-w-2xl">
  <% if @entries.empty? %>
    <%= render EmptyStateComponent.new(icon: :history, text: t(".empty")) %>
  <% end %>

  <% @entries.each do |date, entries| %>
    <% day_id = "day-#{date.iso8601}" %>
    <%= render ListGroupComponent.new(title: l(date, format: :long).upcase_first, id: day_id) do |group| %>
      <% entries.each do |entry| %>
        <% task = entry.task %>
        <%
          what = if task.watering?
            t(".watered", name: task.subject.name)
          elsif task.subject
            t(".task_of", title: task.title, name: task.subject.name)
          else
            task.title
          end
          who = if entry.by_rain?
            t(".by_rain")
          else
            entry.completed_by == Current.user ? t(".by_you") : entry.completed_by&.email.to_s.split("@").first
          end
          date_label = l(date, format: :day)
          cancel_confirm = t(".cancel_confirm", what:, date: date_label)
        %>
        <% unless entry.done? %>
          <%# Missed or postponed: a discreet line, nothing to cancel. %>
          <% group.with_row do %>
            <div class="flex min-h-14 items-center gap-3 px-3 text-muted">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-subtle">
                <%= icon(entry.missed? ? :x : :hourglass) %>
              </span>
              <span class="min-w-0 flex-1 py-2">
                <span class="block font-medium"><%= what %></span>
                <span class="text-sm">
                  <% if entry.missed? %>
                    <%= t(".missed", date: l(entry.due_at.to_date, format: :day)) %>
                  <% else %>
                    <%= [ t(".postponed"), who.presence ].compact.join(" · ") %>
                  <% end %>
                </span>
              </span>
            </div>
          <% end %>
          <% next %>
        <% end %>
        <% group.with_row do %>
          <div class="flex min-h-14 items-center gap-3 pl-3">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-subtle text-plants">
              <%= icon(entry.by_rain? ? :cloud_rain : (task.watering? ? :droplet : :check)) %>
            </span>
            <span class="min-w-0 flex-1 py-2">
              <span class="block font-medium"><%= what %></span>
              <span class="text-sm text-muted">
                <%= [ who.presence, l(entry.completed_at, format: :hour) ].compact.join(" · ") %>
              </span>
            </span>
            <%= button_to t(".cancel"), task_occurrence_completion_path(entry), method: :delete,
                  aria: { label: t(".cancel_label", what:, date: date_label) },
                  form: { data: confirm_data(cancel_confirm, button: t(".cancel_confirm_button")) },
                  class: "mr-1 #{small_action_class}" %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>