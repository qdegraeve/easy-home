<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Easy Home" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Easy Home">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-stone-50 text-stone-800 antialiased">
    <% if authenticated? %>
      <header class="sticky top-0 z-10 border-b border-stone-200 bg-stone-50/95 backdrop-blur">
        <div class="mx-auto flex max-w-md items-center justify-between px-4 py-3 lg:max-w-5xl">
          <%= link_to t(".app_name"), root_path, class: "font-semibold text-emerald-700" %>
          <div class="flex items-center gap-1">
            <%= link_to t(".notifications"), edit_notification_settings_path,
                  aria: { label: t(".notifications_label") },
                  class: "rounded-xl px-3 py-2 text-sm text-stone-600 hover:bg-stone-100" %>
            <%= button_to t(".sign_out"), session_path, method: :delete,
                  class: "rounded-xl px-3 py-2 text-sm text-stone-600 hover:bg-stone-100" %>
          </div>
        </div>
      </header>
    <% end %>

    <main class="mx-auto max-w-md px-4 pb-24 pt-6 lg:max-w-5xl">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>
    <%= render "shared/confirm_dialog" %>
  </body>
</html>