<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Easy Home" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Easy Home">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-paper text-ink antialiased">
    <%# In the Android app, the native top bar replaces this header (settings: button of the "Aujourd'hui" page). %>
    <% if authenticated? && !hotwire_native_app? %>
      <header class="sticky top-0 z-20 border-b border-line bg-paper/95 backdrop-blur">
        <div class="mx-auto flex max-w-md items-center justify-between px-4 py-2 md:max-w-none">
          <%= link_to root_path, class: "flex min-h-11 items-center gap-2 font-semibold text-ink" do %>
            <%= image_tag "/icon.svg", alt: "", class: "size-7" %><%= t(".app_name") %>
          <% end %>
          <%= link_to icon(:sliders_horizontal, size: 22), settings_path, aria: { label: t(".settings") },
                class: "-mr-2 grid size-11 place-items-center rounded-full text-muted hover:bg-subtle" %>
        </div>
      </header>
    <% end %>
    <%= render "shared/tab_bar" if show_tabs? %>

    <main class="<%= class_names("mx-auto max-w-md px-4 pb-40 pt-6 md:max-w-3xl", "md:ml-56 md:mr-0": show_tabs?) %>">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>
    <%= render "shared/confirm_dialog" %>
    <%# Live region for the toasts (toast_controller.js): permanent, so that screen readers notice its changes. %>
    <div id="announcer" class="sr-only" aria-live="polite" data-turbo-permanent></div>
  </body>
</html>