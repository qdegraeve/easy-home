<div class="mx-auto max-w-md">
  <%= link_to t("plants.tasks.back", name: @plant.name), @plant, class: "text-sm text-stone-500 underline" %>
  <h1 class="mt-2 text-2xl font-bold"><%= page_title t(".title") %></h1>

  <div class="mt-6">
    <%= render "form", form: @form, url: plant_tasks_path(@plant), method: :post, adding: true, submit: t(".submit") %>
  </div>
</div>
