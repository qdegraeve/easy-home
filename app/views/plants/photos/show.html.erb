<div class="mx-auto max-w-2xl">
  <%= back_link_to t("plants.tasks.back", name: @plant.name), plant_path(@plant, tab: "photos") %>
  <%# The saved date: a refused date only lives in the form. %>
  <h1 class="mt-2 text-2xl font-bold">
    <%= page_title t(".title", date: l(@photo.taken_at_in_database.in_time_zone.to_date, format: :long)) %>
  </h1>

  <%= image_tag @photo.image.variant(:large), alt: t(".alt", name: @plant.name),
        class: "mt-4 w-full rounded-2xl" %>

  <%# The face of the plant: chosen here, shown on its page. %>
  <div class="mt-4">
    <% if @plant.cover_photo_id == @photo.id %>
      <p class="inline-flex items-center gap-2 text-sm font-semibold text-action">
        <%= icon(:check, size: 18) %><%= t(".cover") %>
      </p>
    <% elsif policy(@photo).update? %>
      <%= button_to t(".make_cover"), plant_photo_cover_path(@plant, @photo), class: button_class(:secondary) %>
    <% end %>
  </div>

  <%= form_with model: @photo, url: plant_photo_path(@plant, @photo), method: :patch, class: "mt-6 space-y-2" do |f| %>
    <%= render "shared/errors", record: @photo %>
    <%= f.label :taken_at, class: "block text-sm font-semibold" %>
    <div class="flex gap-2">
      <%= f.date_field :taken_at, required: true, max: Time.zone.today,
            class: "rounded-xl border border-field bg-surface px-3 py-2" %>
      <%= f.submit t(".save_date"), class: "rounded-xl bg-surface px-3 py-2 text-sm font-semibold shadow-sm" %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= button_to t(".destroy"), plant_photo_path(@plant, @photo), method: :delete,
          form: { data: confirm_data(t(".destroy_confirm"), button: t(".destroy"), danger: true) },
          class: "rounded-xl px-3 py-2 text-sm text-alert hover:bg-alert-soft" %>
  </div>
</div>
