<%# The photo viewer (gallery of a plant): the photo large on a dark background, the older one on the left, the newer
    one on the right, as on a timeline. Swipe and arrow keys follow the same links (photo_viewer_controller.js).
    Each photo has its own page, replaced on the way ("back" leaves the photos instead of going through each). %>
<% content_for(:body_class, "bg-ink text-white") %>
<% content_for(:head) { tag.meta(name: "view-transition", content: "same-origin") } %>
<% date = l(@photo.taken_at.to_date, format: :long) %>
<% cover = @plant.cover_photo_id == @photo.id %>
<% preload = [ @older, @newer ].compact.map { url_for(it.image.variant(:large)) } %>

<div class="mx-auto max-w-3xl" data-controller="photo-viewer" data-photo-viewer-preload-value="<%= preload.to_json %>"
     data-action="keydown@window->photo-viewer#key">
  <% if (back = back_link_to(t("plants.tasks.back", name: @plant.name), plant_path(@plant, tab: "photos"))) %>
    <p class="[&_a]:text-white/70"><%= back %></p>
  <% end %>

  <div class="relative mt-3">
    <div class="-mx-4 grid min-h-[50dvh] place-items-center overflow-hidden [touch-action:pan-y_pinch-zoom] sm:mx-0"
         data-action="pointerdown->photo-viewer#start pointermove->photo-viewer#move pointerup->photo-viewer#end
                      pointercancel->photo-viewer#cancel">
      <%= image_tag @photo.image.variant(:large), alt: t(".alt", name: @plant.name, date:), draggable: false,
            data: { photo_viewer_target: "image" },
            class: "max-h-[70dvh] max-w-full select-none object-contain [view-transition-name:photo] sm:rounded-lg" %>
    </div>

    <nav aria-label="<%= t(".browse") %>" class="mt-3 flex items-center justify-between gap-2">
      <% link_class = "inline-grid size-12 shrink-0 place-items-center rounded-full text-white hover:bg-white/10 " \
                      "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white " \
                      "md:absolute md:top-1/3 md:bg-white/10" %>
      <% if @older %>
        <%= link_to plant_photo_path(@plant, @older), class: "#{link_class} md:-left-16",
              data: { turbo_action: "replace", photo_viewer_target: "older", action: "photo-viewer#mark" } do %>
          <%= icon(:chevron_left) %><span class="sr-only"><%= t(".older") %></span>
        <% end %>
      <% else %>
        <span class="size-12 shrink-0 md:hidden"></span>
      <% end %>

      <div class="min-w-0 flex-1 text-center">
        <h1 class="truncate text-base font-semibold"><%= page_title t(".title", date:) %></h1>
        <p class="text-sm tabular-nums text-white/70">
          <%= t(".position", position: @position, count: @count) %>
          <% if cover %>
            <span class="ml-2 inline-flex items-center gap-1 font-semibold text-action-soft">
              <%= icon(:check, size: 16) %><%= t(".cover") %>
            </span>
          <% end %>
        </p>
      </div>

      <% if @newer %>
        <%= link_to plant_photo_path(@plant, @newer), class: "#{link_class} md:-right-16",
              data: { turbo_action: "replace", photo_viewer_target: "newer", action: "photo-viewer#mark" } do %>
          <%= icon(:chevron_right) %><span class="sr-only"><%= t(".newer") %></span>
        <% end %>
      <% else %>
        <span class="size-12 shrink-0 md:hidden"></span>
      <% end %>
    </nav>
  </div>

  <%# In the Android app, these actions go to the "⋮" menu of the native top bar (bridge--menu); the id changes with
      the cover, so that a refresh sends the menu again. The cover and the deletion stay in the viewer, replacing the
      page: "back" never comes back to a deleted photo. %>
  <div id="photo-actions-<%= cover ? "cover" : "photo" %>" class="mt-6 flex flex-wrap justify-center gap-2"
       data-controller="bridge--menu">
    <% if policy(@photo).update? %>
      <%= link_to t(".edit_date"), edit_plant_photo_path(@plant, @photo), class: button_class(:on_dark),
            data: { bridge__menu_target: "item" } %>
      <% unless cover %>
        <%= button_to t(".make_cover"), plant_photo_cover_path(@plant, @photo), class: button_class(:on_dark),
              form: { data: { turbo_action: "replace" } }, data: { bridge__menu_target: "item" } %>
      <% end %>
    <% end %>
    <%= button_to t(".destroy"), plant_photo_path(@plant, @photo), method: :delete,
          form: { data: { turbo_action: "replace", action: "photo-viewer#forgetDirection",
                          **confirm_data(t(".destroy_confirm"), button: t(".destroy"), danger: true) } },
          class: button_class(:on_dark), data: { bridge__menu_target: "item" } %>
  </div>
</div>