<div class="mx-auto max-w-md">
  <%= back_link_to t("shared.back_to", name: @plant.name), @plant %>
  <h1 class="mt-2 text-2xl font-bold" data-screen-title><%= page_title t(".title", name: @plant.name) %></h1>

  <div class="mt-6">
    <%= render "form", form: @form, url: plant_path(@plant), method: :patch, adding: false, submit: t(".submit") %>
  </div>
</div>
