<%# Follow-up questions of a finished analysis and their answers, as a thread of notes (not chat bubbles: UX review
    #41), then the form for the next question, folded behind "Poser une question". %>
<section
  class="space-y-3 border-t border-line pt-3"
  aria-label="<%= t("plants.analysis_questions.thread.title") %>"
>
  <% analysis.questions.each do |question| %>
    <div class="space-y-2 text-sm">
      <div class="space-y-2 border-l-2 border-line pl-3 text-muted">
        <%= simple_format(h(question.body)) %>
        <% if question.photo %>
          <%= image_tag question.photo.image.variant(:thumb), class: "h-16 w-16 rounded-xl object-cover",
                alt: t("plants.analysis_questions.thread.photo_alt",
                       date: l(question.photo.taken_at.to_date, format: :day)) %>
        <% end %>
      </div>
      <div class="space-y-2 pl-3">
        <% if question.pending? %>
          <p><%= heading_with_icon(:hourglass, t("plants.analysis_questions.thread.pending")) %></p>
        <% elsif question.failed? %>
          <p role="alert" class="text-alert"><%= t("plants.analysis_questions.thread.failed") %></p>
          <% if policy(question).ask_again? %>
            <%= button_to t("plants.analysis_questions.thread.ask_again"),
                  ask_again_plant_analysis_question_path(analysis.plant, analysis, question),
                  class: "mt-2 #{button_class(:secondary)}" %>
          <% end %>
        <% else %>
          <%# Escaped first: AI text is plain text, never HTML. %>
          <%= simple_format(h(question.answer)) %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% questions = analysis.questions %>
  <% if questions.any?(&:pending?) %>
    <%# Nothing: the next question waits for this answer. %>
  <% elsif questions.size >= PlantAnalysisQuestion::MAX_PER_ANALYSIS %>
    <p class="text-[13px] text-muted">
      <%= t("plants.analysis_questions.thread.limit", count: PlantAnalysisQuestion::MAX_PER_ANALYSIS) %>
    </p>
  <% elsif policy(PlantAnalysisQuestion.new(plant_analysis_id: analysis.id)).create? %>
    <details class="group">
      <summary class="<%= button_class(:secondary) %> cursor-pointer list-none [&::-webkit-details-marker]:hidden">
        <%= t("plants.analysis_questions.thread.ask") %>
      </summary>
      <div class="mt-3"><%= render "plants/analysis_questions/form", analysis:, form: QuestionForm.new %></div>
    </details>
  <% end %>
</section>
