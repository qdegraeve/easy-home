<%# "Soins" tab: the state of the plant (last analysis), then its other tasks. %>
<section aria-labelledby="analysis" class="space-y-3">
  <h2 id="analysis" class="font-semibold"><%= heading_with_icon(:activity, t("plants.show.analysis")) %></h2>
  <%# Not while an analysis runs (the restart itself), nor for an archived plant (nothing to offer). %>
  <% change = @plant.place_change_since_analysis unless @plant.archived? || @analyses.first&.pending? %>
  <% if change %>
    <%# The place changed since the last analysis: its advice may be wrong. Offered, never run by itself. %>
    <div role="note" class="mt-2 rounded-2xl bg-warn-soft p-4 text-sm">
      <% places = { before: place_label(change.first), after: place_label(change.last) } %>
      <p class="font-semibold">
        <%= heading_with_icon(:map_pin, t("plants.show.place_changed"), icon_class: "text-warn") %>
      </p>
      <p class="mt-1"><%= t("plants.show.place_changed_detail", **places) %></p>
      <% if @photos.any? && policy(PlantAnalysis.new(plant: @plant)).create? %>
        <%= link_to t("plants.show.reanalyse"),
              new_plant_analysis_path(@plant, note: t("plants.show.reanalyse_note", **places)),
              class: "mt-3 #{button_class(:secondary)}" %>
      <% end %>
    </div>
  <% end %>
  <% latest = @analyses.first %>
  <%# A guest sees the plant, not its analyses (ADR 0019). %>
  <% if latest && policy(latest).show? %>
    <%= render "plants/analyses/summary", analysis: latest,
          restart: latest.failed? && policy(PlantAnalysis.new(plant: @plant)).create? %>
  <% elsif policy(PlantAnalysis.new(plant: @plant)).create? %>
    <%= render EmptyStateComponent.new(text: t("plants.show.no_analysis")) %>
  <% end %>
  <% if @photos.any? && !latest&.pending? && policy(PlantAnalysis.new(plant: @plant)).create? %>
    <%# In the Android app, the small floating button above "+" (bridge--button, order 2). %>
    <%= link_to t("plants.show.new_analysis"), new_plant_analysis_path(@plant),
          class: button_class(:secondary, block: true),
          data: { controller: "bridge--button", bridge_title: t("plants.show.new_analysis"), bridge_icon: "analysis",
                  bridge_label: t("plants.show.new_analysis_label"), bridge_order: 2 } %>
  <% end %>
</section>

<div>
  <%= render ListGroupComponent.new(title: t("plants.show.tasks"), id: "tasks", icon: :list_todo) do |group| %>
    <% @other_tasks.each do |task| %>
      <% group.with_row do %>
        <%# The row opens the task sheet (how to do it), which leads to its edit screen. %>
        <%= render TaskRowComponent.new(
          occurrence: task.pending_occurrence,
          title: task.title,
          href: task_path(task),
          detail: rhythm_label(task),
          done_today: @done_today_task_ids.include?(task.id)
        ) %>
      <% end %>
    <% end %>
    <% @on_demand_tasks.each do |task| %>
      <% group.with_row { render(OnDemandTaskRowComponent.new(task:, last_done_at: @last_done_at[task.id])) } %>
    <% end %>
    <%= render EmptyStateComponent.new(text: t("plants.show.no_tasks")) %>
  <% end %>
  <% if policy(Task.new(household: @plant.household, subject: @plant)).create? %>
    <%# In the Android app, the main floating "+" (bridge--button). %>
    <%= link_to t("plants.show.add_task"), new_plant_task_path(@plant),
          class: "mt-3 #{button_class(:secondary, block: true)}",
          data: { controller: "bridge--button", bridge_title: t("plants.show.add_task"), bridge_icon: "plus",
                  bridge_label: t("plants.show.add_task_label") } %>
  <% end %>
</div>