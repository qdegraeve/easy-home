<% content_for :head do %>
  <%# The answer job refreshes the plant pages when it finishes (ADR 0008). %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from @plant %>

<div class="mx-auto max-w-2xl">
  <%= back_link_to t("plants.tasks.back", name: @plant.name), @plant %>
  <h1 class="mt-2 text-2xl font-bold" data-screen-title><%= page_title t(".title", name: @plant.name) %></h1>

  <div class="mt-4">
    <%# A failed analysis is restarted here, where the user waited for it. %>
    <%= render "plants/analyses/analysis", analysis: @analysis,
          restart: @analysis.failed? && policy(PlantAnalysis.new(plant: @plant)).create? %>
  </div>
</div>
