<%# One analysis: pending, failed (with a restart button) or done. Rendered on the plant page and on its own page. %>
<article class="space-y-3 rounded-2xl bg-white p-4 shadow-sm">
  <header class="flex items-center justify-between gap-3 text-sm text-stone-500">
    <span><%= t("plants.analyses.analysis.requested_on", date: l(analysis.created_at.to_date, format: :day)) %></span>
    <% if analysis.done? %>
      <span class="rounded-full bg-stone-100 px-3 py-1 font-semibold text-stone-800">
        <%= t("plants.analyses.analysis.health.#{analysis.health}") %>
      </span>
    <% end %>
  </header>

  <% if analysis.pending? %>
    <p><%= t("plants.analyses.analysis.pending") %></p>
  <% elsif analysis.failed? %>
    <p role="alert" class="text-red-800"><%= t("plants.analyses.analysis.failed") %></p>
    <% if restart %>
      <%= button_to t("plants.analyses.analysis.restart"), plant_analyses_path(analysis.plant),
            params: { plant_analysis: { note: analysis.user_note, photo_ids: analysis.photo_ids } },
            class: "rounded-xl bg-white px-3 py-2 text-sm font-semibold shadow-sm ring-1 ring-stone-200" %>
    <% end %>
  <% else %>
    <% if analysis.species_name %>
      <p>
        <span class="italic"><%= analysis.species_name %></span>
        <% if analysis.species_common_name %>(<%= analysis.species_common_name %>)<% end %>
        <span class="text-sm text-stone-500">
          · <%= t("plants.analyses.analysis.confidence.#{analysis.species_confidence}") %>
        </span>
      </p>
    <% end %>
    <%= simple_format(analysis.observations, class: "text-sm") %>
    <% if analysis.watering_interval_days %>
      <p class="text-sm">
        <%= t("plants.analyses.analysis.watering", count: analysis.watering_interval_days) %>
      </p>
    <% end %>
    <% if analysis.actions.any? %>
      <h3 class="text-sm font-semibold"><%= t("plants.analyses.analysis.actions") %></h3>
      <ul class="space-y-2 text-sm">
        <% analysis.actions.each do |action| %>
          <li>
            <p class="font-medium">
              <%= action["title"] %>
              <span class="font-normal text-stone-500">
                · <%= t("plants.analyses.analysis.due_in", count: action["due_in_days"]) %>
              </span>
            </p>
            <% if action["details"].present? %><p class="text-stone-600"><%= action["details"] %></p><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <footer class="space-y-2 border-t border-stone-100 pt-3 text-xs text-stone-500">
    <% if analysis.user_note.present? %>
      <p><%= t("plants.analyses.analysis.note", note: analysis.user_note) %></p>
    <% end %>
    <ul class="flex gap-2" aria-label="<%= t("plants.analyses.analysis.photos") %>">
      <% analysis.photos_oldest_first.each do |photo| %>
        <li>
          <%= image_tag photo.image.variant(:thumb), class: "h-12 w-12 rounded-lg object-cover",
                alt: t("plants.analyses.analysis.photo_alt", date: l(photo.taken_at.to_date, format: :day)) %>
        </li>
      <% end %>
    </ul>
  </footer>
</article>
