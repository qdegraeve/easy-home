<%# One proposal of an analysis: accepted already, or a button to accept it (owner and member, plant not archived).
    Every proposal uses the same pill (design review): accepted, the same shape filled, with a check. %>
<% if accepted %>
  <span class="inline-flex min-h-11 shrink-0 items-center">
    <span class="<%= accepted_chip_class %>">
      <%= icon(:check, size: 16) %><%= accepted_label %>
    </span>
  </span>
<% elsif acceptable %>
  <%= button_to url, aria: { label: local_assigns[:aria_label] }, class: chip_class do %>
    <span class="<%= chip_inner_class %>"><%= label %></span>
  <% end %>
<% end %>