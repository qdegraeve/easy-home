<% content_for :head do %>
  <%# The analysis job refreshes this page when it finishes (ADR 0008). %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from @plant %>

<%= back_link_to t("plants.back"), plants_path %>

<%# Who the plant is: its face (the cover photo, or the latest), name, species and place. %>
<div class="mt-2 flex items-center gap-4">
  <% if (face = @plant.face) %>
    <%= link_to plant_photo_path(@plant, face), class: "shrink-0" do %>
      <%= image_tag face.image.variant(:thumb), alt: t(".face_alt", name: @plant.name),
            class: "size-16 rounded-2xl object-cover" %>
    <% end %>
  <% else %>
    <span class="grid size-16 shrink-0 place-items-center rounded-2xl bg-subtle text-plants">
      <%= icon(:sprout, size: 28) %>
    </span>
  <% end %>
  <div class="min-w-0">
    <h1 class="text-2xl font-bold"><%= page_title @plant.name %></h1>
    <% if @plant.species %>
      <p class="italic text-muted"><%= @plant.species %></p>
    <% end %>
    <% if @plant.location %>
      <p class="text-sm text-muted">
        <%= icon(:map_pin, size: 16) %> <%= @plant.location.name %> · <%= exposure_label(@plant.location.exposure) %>
      </p>
    <% end %>
  </div>
</div>
<% if @plant.archived? %>
  <p class="mt-3 rounded-xl bg-subtle px-3 py-2 text-sm">
    <%= t(".archived_on", date: l(@plant.archived_at.to_date, format: :long)) %>
  </p>
<% end %>

<%# On a computer, the plant page uses the width: the parts of a tab side by side (lists elsewhere keep a reading
    width). %>
<div class="mt-6 space-y-6">
  <%# The next action first: watering. %>
  <section class="space-y-2 rounded-2xl bg-surface p-4" aria-labelledby="watering">
    <h2 id="watering" class="font-semibold">
      <%= heading_with_icon(:droplet, t(".watering"), icon_class: "text-plants") %>
    </h2>
    <p><%= t(".every", count: @watering_task.recurrence.interval_days) %></p>
    <% if (occurrence = @watering_task.pending_occurrence) %>
      <div class="flex items-center justify-between gap-3">
        <p><%= t(".next") %> <%= render DueLabelComponent.new(due_at: occurrence.due_at) %></p>
        <% if @done_today_task_ids.include?(@watering_task.id) %>
          <span class="inline-flex shrink-0 items-center gap-1 text-sm text-muted">
            <%= icon(:check, size: 16) %><%= t(".watered_today") %>
          </span>
        <% else %>
          <%= render "tasks/complete_button", occurrence: %>
        <% end %>
      </div>
    <% end %>
    <%# Said under the date, which would otherwise look wrong. %>
    <% if @watering_task.moved_by_rain? %>
      <p class="text-sm text-muted"><%= heading_with_icon(:cloud_rain, t(".postponed_by_rain_note")) %></p>
    <% end %>
    <% if @last_watering %>
      <p class="text-sm text-muted">
        <%= t(@last_watering.by_rain? ? ".last_watered_by_rain" : ".last_watered",
              date: l(@last_watering.completed_at.to_date, format: :day)) %>
      </p>
    <% end %>
  </section>

  <%= render "plants/tabs", plant: @plant, current: @tab %>

  <div class="space-y-6 lg:grid lg:grid-cols-2 lg:items-start lg:gap-6 lg:space-y-0">
    <%= render "plants/tab_#{@tab}" %>
  </div>
</div>

<%# In the Android app, these actions go to the "⋮" menu of the native top bar (bridge--menu). The id changes with
    the state of the plant: a morph refresh then replaces the whole block, and the menu is sent again with the right
    actions (a morph would otherwise only rename "Archiver" into "Restaurer" in place). %>
<% if policy(@plant).update? %>
<div
  id="plant-actions-<%= @plant.archived? ? "archived" : "active" %>"
  class="mt-8 flex flex-wrap gap-3"
  data-controller="bridge--menu"
>
  <%= link_to t(".edit"), edit_plant_path(@plant),
        class: button_class(:secondary), data: { bridge__menu_target: "item" } %>
  <% if @plant.archived? %>
    <%= button_to t(".restore"), plant_archive_path(@plant), method: :delete,
          class: button_class(:secondary), data: { bridge__menu_target: "item" } %>
  <% else %>
    <%= button_to t(".archive"), plant_archive_path(@plant),
          form: { data: confirm_data(t(".archive_confirm"), button: t(".archive")) },
          class: button_class(:secondary), data: { bridge__menu_target: "item" } %>
  <% end %>
  <%# Replace: in the Android app, the deleted plant leaves the stack ("back" never shows it again). %>
  <%= button_to(
    t(".destroy"),
    plant_path(@plant),
    method: :delete,
    form: {
      data: { turbo_action: "replace", **confirm_data(t(".destroy_confirm"), button: t(".destroy"), danger: true) }
    },
    class: button_class(:danger),
    data: { bridge__menu_target: "item" }
  ) %>
</div>
<% end %>