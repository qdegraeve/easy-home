<div class="mx-auto max-w-sm pt-10">
  <p class="text-xs font-semibold uppercase tracking-wide text-action"><%= t("layouts.application.app_name") %></p>
  <h1 class="text-2xl font-bold" data-screen-title><%= page_title t(".title") %></h1>

  <%# The gap is on the form: in the app, the title is hidden and its margins with it. %>
  <%= form_with url: session_path, class: "mt-6 space-y-4" do |form| %>
    <%= form.label :email, t(".email_label"), class: "block text-sm font-semibold" %>
    <%= form.email_field(
      :email,
      required: true,
      autofocus: true,
      autocomplete: "username",
      placeholder: t(".email_placeholder"),
      value: params[:email],
      class: "w-full rounded-xl border border-field bg-surface px-3 py-3"
    ) %>
    <%= form.label :password, t(".password_label"), class: "block text-sm font-semibold" %>
    <%= form.password_field(
      :password,
      required: true,
      autocomplete: "current-password",
      placeholder: t(".password_placeholder"),
      maxlength: 72,
      class: "w-full rounded-xl border border-field bg-surface px-3 py-3"
    ) %>
    <%= form.submit t(".submit"), class: "w-full rounded-xl bg-action py-3 font-semibold text-white" %>
  <% end %>

  <p class="mt-6 text-center text-sm">
    <%= link_to t(".forgot_password"), new_password_path, class: "text-muted underline" %>
  </p>
  <p class="mt-3 text-center text-sm">
    <%= link_to t("accounts.edit.privacy"), privacy_path, class: "text-muted underline" %>
  </p>
</div>