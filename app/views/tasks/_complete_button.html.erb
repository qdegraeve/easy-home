<%# "Arrosée" / "Fait" button of an open occurrence, with its text (lists use TaskRowComponent's round button). %>
<% task = occurrence.task %>
<% if task.watering? %>
  <% label, aria_label = t("plants.water"), t("plants.water_label", name: task.subject.name) %>
<% else %>
  <% label, aria_label = t("tasks.done"), t("tasks.done_label", title: task.title, subject: task.subject.name) %>
<% end %>
<%= button_to(
  task_occurrence_completion_path(occurrence),
  aria: { label: aria_label },
  class: button_class(:primary)
) do %>
  <%= icon(:check) %><%= label %>
<% end %>