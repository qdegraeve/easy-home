<%# A manual task, of a plant or of the house (house: true). On creation, the interval field and the date label follow
    the "Quand ?" choice (CSS :has, no JavaScript). %>
<%= form_with model: form, url:, method:, class: "group space-y-4" do |f| %>
  <%= render "shared/errors", record: form %>

  <div>
    <%= f.label :title, class: "block text-sm font-semibold" %>
    <% placeholder = house ? "tasks.form.title_placeholder_house" : "tasks.form.title_placeholder" %>
    <%= f.text_field :title, required: true, maxlength: 100, placeholder: t(placeholder),
          class: "mt-1 w-full rounded-xl border border-field bg-surface px-3 py-3" %>
  </div>

  <% if adding %>
    <fieldset>
      <legend class="text-sm font-semibold"><%= t("tasks.form.repeat") %></legend>
      <div class="mt-1 space-y-2">
        <% TaskForm::KINDS.each do |kind| %>
          <label class="flex items-center gap-2 rounded-xl border border-field bg-surface px-3 py-3">
            <%= f.radio_button :recurrence_type, kind %>
            <span><%= t("tasks.form.kinds.#{kind}") %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <div>
    <% if adding %>
      <%= f.label :due_on, class: "block text-sm font-semibold" do %>
        <span class="group-has-[[value=sliding]:checked]:hidden"><%= t("tasks.form.due_on.once") %></span>
        <span class="hidden group-has-[[value=sliding]:checked]:inline">
          <%= t("tasks.form.due_on.first") %>
        </span>
      <% end %>
    <% else %>
      <%= f.label :due_on, t("tasks.form.due_on.#{form.recurrence_type}"),
            class: "block text-sm font-semibold" %>
    <% end %>
    <%= f.date_field :due_on, required: true,
          class: "mt-1 w-full rounded-xl border border-field bg-surface px-3 py-3" %>
  </div>

  <% if adding || form.sliding? %>
    <div class="<%= "hidden group-has-[[value=sliding]:checked]:block" if adding %>">
      <%= f.label :interval_days, class: "block text-sm font-semibold" %>
      <div class="mt-1 flex items-center gap-2">
        <span class="text-sm"><%= t("plants.form.every") %></span>
        <%= f.number_field :interval_days, min: 1, max: 60,
              class: "w-20 rounded-xl border border-field bg-surface px-3 py-3" %>
        <span class="text-sm"><%= t("plants.form.days") %></span>
      </div>
    </div>
  <% end %>

  <div>
    <label class="flex items-start gap-3 rounded-xl border border-field bg-surface px-3 py-3">
      <%= f.check_box :critical, class: "mt-1" %>
      <span>
        <span class="block font-semibold"><%= t("tasks.form.critical") %></span>
        <span class="block text-sm text-muted"><%= t("tasks.form.critical_help") %></span>
      </span>
    </label>
  </div>

  <div>
    <%= f.label :instructions, class: "block text-sm font-semibold" %>
    <%= f.text_area :instructions, rows: 4, maxlength: Task::INSTRUCTIONS_MAX,
          placeholder: t("tasks.form.instructions_placeholder"), aria: { describedby: "instructions-help" },
          class: "mt-1 w-full rounded-xl border border-field bg-surface px-3 py-3" %>
    <p id="instructions-help" class="mt-1 text-[13px] text-muted"><%= t("tasks.form.instructions_help") %></p>
  </div>

  <%= f.submit submit, class: button_class(:primary, block: true) %>
<% end %>
