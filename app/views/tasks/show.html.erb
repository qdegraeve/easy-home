<%# The task sheet (a modal in the Android app): what to do, for what, when, and how ("Comment faire"), with "Fait"
    and "Reporter" at hand. The instructions are user text: escaped, line breaks kept. %>
<div class="mx-auto max-w-md">
  <% if @task.subject %>
    <%= back_link_to t("plants.tasks.back", name: @task.subject.name), @task.subject %>
  <% else %>
    <%= back_link_to t("tasks.back_house"), house_tasks_path %>
  <% end %>
  <h1 class="mt-2 text-2xl font-bold" data-screen-title><%= page_title @task.title %></h1>
  <p class="text-sm text-muted">
    <% if @task.subject %>
      <%= link_to @task.subject.name, @task.subject, class: "underline" %>
    <% else %>
      <%= t(".house") %>
    <% end %>
  </p>

  <section class="mt-6 space-y-3 rounded-2xl bg-surface p-4" aria-labelledby="task-when">
    <h2 id="task-when" class="sr-only"><%= t(".next") %></h2>
    <% if @occurrence %>
      <p>
        <%= t(".next") %>
        <%= render DueLabelComponent.new(due_at: @occurrence.due_at, critical: @task.critical?) %>
      </p>
      <div class="flex flex-wrap items-center gap-2">
        <%= button_to task_occurrence_completion_path(@occurrence),
              aria: { label: t(".done_label", title: @task.title) },
              class: button_class(@occurrence.due_at.to_date <= Time.zone.today ? :primary : :secondary) do %>
          <%= icon(:check) %><%= t(".done") %>
        <% end %>
        <% if @occurrence.due_at.to_date <= Time.zone.today %>
          <%= button_to task_occurrence_postponement_path(@occurrence),
                aria: { label: t("task_row_component.postpone", title: @task.title) }, class: chip_class do %>
            <span class="<%= chip_inner_class %>">
              <%= icon(:redo_2, size: 16) %><%= t("task_row_component.postpone_button") %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted"><%= t(".none") %></p>
    <% end %>
    <% if @last_done_at %>
      <p class="text-sm text-muted"><%= t(".last_done", date: l(@last_done_at.to_date, format: :day)) %></p>
    <% end %>
  </section>

  <section class="mt-6" aria-labelledby="task-how">
    <h2 id="task-how" class="text-[13px] font-semibold text-muted"><%= t(".instructions") %></h2>
    <% if @task.instructions.present? %>
      <div class="mt-2 space-y-2 rounded-2xl bg-surface p-4"><%= simple_format(h(@task.instructions)) %></div>
    <% else %>
      <p class="mt-2 text-sm text-muted">
        <%= t(".no_instructions") %>
        <% if policy(@task).edit? %>
          <%= link_to t(".add_instructions"), edit_task_path(@task), class: "font-semibold text-action underline" %>
        <% end %>
      </p>
    <% end %>
  </section>

  <% if policy(@task).edit? %>
    <%= link_to t(".edit"), edit_task_path(@task), class: "mt-6 #{button_class(:secondary, block: true)}" %>
  <% end %>
</div>