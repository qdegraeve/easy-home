<%# The three sections of the app (UX review): at the bottom of the screen on a phone, a column on the left on a
    computer. In the Android app, native tabs will replace it (UX review, PR 7). %>
<% tabs = [
  [ :today, :calendar_check, root_path ],
  [ :house, :house, house_path ],
  [ :journal, :history, journal_path ]
] %>
<nav
  aria-label="<%= t("tab_bar.label") %>"
  class="fixed inset-x-0 bottom-0 z-20 flex border-t border-line bg-paper/95 pb-[env(safe-area-inset-bottom)]
         backdrop-blur md:inset-x-auto md:top-[61px] md:left-0 md:w-56 md:flex-col md:border-r md:border-t-0 md:p-3"
>
  <% tabs.each do |tab, icon_name, path| %>
    <% current = current_tab == tab %>
    <%= link_to path, aria: { current: (current ? "page" : nil) },
          class: class_names(
            "flex min-h-14 flex-1 flex-col items-center justify-center gap-0.5 text-xs md:flex-none md:flex-row",
            "md:justify-start md:gap-3 md:rounded-xl md:px-3 md:text-sm",
            "font-semibold text-action md:bg-action-soft": current,
            "text-muted hover:text-ink": !current
          ) do %>
      <%= icon(icon_name, size: 22) %><%= t("tab_bar.#{tab}") %>
    <% end %>
  <% end %>
</nav>