<%# Used by app/javascript/lib/confirm_dialog.js for data-turbo-confirm forms (see ApplicationHelper#confirm_data). %>
<%# Permanent: a morph refresh (plant page, ADR 0008) must not close or reset an open confirmation. %>
<dialog id="confirm-dialog" aria-labelledby="confirm-dialog-message" data-turbo-permanent
        class="m-auto w-[calc(100%-2rem)] max-w-sm rounded-2xl p-5 shadow-xl backdrop:bg-ink/40">
  <form method="dialog" class="space-y-4">
    <p id="confirm-dialog-message" data-confirm-message class="text-ink"></p>
    <div class="flex justify-end gap-2">
      <button value="cancel" class="rounded-xl px-4 py-3 text-sm text-muted hover:bg-subtle">
        <%= t("shared.confirm_dialog.cancel") %>
      </button>
      <button
        value="confirm"
        data-default-label="<%= t("shared.confirm_dialog.confirm") %>"
        class="rounded-xl bg-action px-4 py-3 text-sm font-semibold text-white data-[tone=danger]:bg-alert"
      ><%= t("shared.confirm_dialog.confirm") %></button>
    </div>
  </form>
</dialog>