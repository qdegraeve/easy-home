<div class="mx-auto max-w-sm pt-10">
  <h1 class="mb-6 text-2xl font-bold" data-screen-title><%= page_title t(".title") %></h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
    <%= form.label :password, t(".password_placeholder"), class: "block text-sm font-semibold" %>
    <%= form.password_field(
      :password,
      required: true,
      autocomplete: "new-password",
      placeholder: t(".password_placeholder"),
      maxlength: 72,
      class: "w-full rounded-xl border border-field bg-surface px-3 py-3"
    ) %>
    <%= form.label :password_confirmation, t(".password_confirmation_placeholder"), class: "block text-sm font-semibold" %>
    <%= form.password_field(
      :password_confirmation,
      required: true,
      autocomplete: "new-password",
      placeholder: t(".password_confirmation_placeholder"),
      maxlength: 72,
      class: "w-full rounded-xl border border-field bg-surface px-3 py-3"
    ) %>
    <%= form.submit t(".submit"), class: "w-full rounded-xl bg-action py-3 font-semibold text-white" %>
  <% end %>
</div>