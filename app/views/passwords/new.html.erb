<div class="mx-auto max-w-sm pt-10">
  <h1 class="mb-6 text-2xl font-bold"><%= page_title t(".title") %></h1>

  <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
    <%= form.label :email, t("sessions.new.email_label"), class: "block text-sm font-semibold" %>
    <%= form.email_field(
      :email,
      required: true,
      autofocus: true,
      autocomplete: "username",
      placeholder: t(".email_placeholder"),
      value: params[:email],
      class: "w-full rounded-xl border border-line bg-surface px-3 py-3"
    ) %>
    <%= form.submit t(".submit"), class: "w-full rounded-xl bg-action py-3 font-semibold text-white" %>
  <% end %>

  <p class="mt-6 text-center text-sm">
    <%= link_to t(".back"), new_session_path, class: "text-muted underline" %>
  </p>
</div>