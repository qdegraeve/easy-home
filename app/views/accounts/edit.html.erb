<div class="mx-auto max-w-2xl">
  <%= back_link_to t(".back"), settings_path %>
  <h1 class="mt-2 text-2xl font-bold" data-screen-title><%= page_title t(".title") %></h1>

  <%= form_with(
    model: @user,
    url: account_path,
    method: :patch,
    class: "mt-6 space-y-4 rounded-2xl bg-surface p-4"
  ) do |form| %>
    <%= render "shared/errors", record: @user %>

    <div>
      <%= form.label :name, class: "block text-sm font-semibold" %>
      <%= form.text_field(
        :name,
        autocomplete: "given-name",
        class: "mt-1 w-full rounded-xl border border-field px-3 py-3"
      ) %>
      <p class="mt-1 text-[13px] text-muted"><%= t(".name_help") %></p>
    </div>

    <div>
      <p class="text-sm font-semibold"><%= User.human_attribute_name(:email) %></p>
      <p class="mt-1 break-words"><%= @user.email %></p>
    </div>

    <%= form.submit t(".save"), class: button_class(:primary, block: true) %>
  <% end %>

  <%# Required by the app stores (ADR 0019): said plainly before confirming, with the password. %>
  <section class="mt-8 space-y-3 rounded-2xl bg-surface p-4" aria-labelledby="delete-account">
    <h2 id="delete-account" class="font-semibold"><%= t(".delete_title") %></h2>
    <p class="text-sm text-muted"><%= t(".delete_help") %></p>
    <% if @households_to_hand_over.any? %>
      <p class="text-sm" id="hand-over">
        <%= t(".hand_over", households: @households_to_hand_over.map(&:name).to_sentence) %>
        <%= link_to t(".members_link"), members_path, class: "font-semibold text-action underline" %>
      </p>
    <% else %>
      <% if @households_alone.any? %>
        <p class="text-sm font-semibold text-alert" id="households-alone">
          <%= t(".households_alone", count: @households_alone.size,
                households: @households_alone.map(&:name).to_sentence) %>
        </p>
      <% end %>
      <%= form_with(
        url: account_path,
        method: :delete,
        class: "space-y-3",
        data: confirm_data(t(".delete_confirm"), button: t(".delete"), danger: true)
      ) do |form| %>
        <div>
          <%= form.label :password, t(".password"), class: "block text-sm font-semibold" %>
          <%= form.password_field(
            :password,
            required: true,
            autocomplete: "current-password",
            maxlength: 72,
            class: "mt-1 w-full rounded-xl border border-field px-3 py-3"
          ) %>
        </div>
        <%= form.submit t(".delete"), class: button_class(:danger, block: true) %>
      <% end %>
    <% end %>
  </section>

  <p class="mt-6 text-center text-sm">
    <%= link_to t(".privacy"), privacy_path, class: "text-muted underline" %>
  </p>
</div>
