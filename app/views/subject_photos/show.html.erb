<%# A photo of an equipment or a task, in large, with its date; deleted behind a confirmation. %>
<div class="mx-auto max-w-3xl">
  <%= back_link_to t("shared.back_to", name: photo_subject_name(@subject)), photos_home_path(@subject) %>
  <h1 class="mt-2 text-2xl font-bold" data-screen-title>
    <%= page_title t(".title", date: l(@photo.taken_at.to_date, format: :long)) %>
  </h1>

  <%# A box of fixed height, as in the plant photo viewer: the button below never moves when the photo arrives (a tap
      aimed at it would otherwise land elsewhere). %>
  <div class="mt-4 grid h-[60dvh] place-items-center">
    <%= image_tag @photo.image.variant(:large),
          alt: t(".alt", name: photo_subject_name(@subject), date: l(@photo.taken_at.to_date, format: :day)),
          class: "max-h-full max-w-full rounded-2xl object-contain" %>
  </div>

  <% if policy(@photo).destroy? %>
    <%= button_to t(".destroy"), polymorphic_path([ @subject, @photo ]), method: :delete,
          form: { class: "mt-6", data: { turbo_action: "replace", # "back" never shows the deleted photo again
                                         **confirm_data(t(".destroy_confirm"), button: t(".destroy"), danger: true) } },
          class: button_class(:danger, block: true) %>
  <% end %>
</div>