<% content_for :head do %>
  <%# A completion redirects here: morph the page and keep the scroll, so that the list does not jump. %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>

<div class="flex items-start justify-between gap-3">
  <div>
    <%= link_to @household.name, households_path,
          class: "text-sm font-semibold text-action underline-offset-2 hover:underline" %>
    <h1 class="text-2xl font-bold"><%= page_title t(".title") %></h1>
    <p class="text-sm text-muted"><%= l(Time.zone.today, format: :long).upcase_first %></p>
  </div>
</div>

<div class="mt-6 space-y-6 lg:max-w-2xl">
  <% if @rain %>
    <% rainfall = @rain[:rainfall] %>
    <p class="flex items-center gap-3 rounded-2xl bg-surface px-3 py-3 text-sm" id="rain">
      <span class="grid size-9 shrink-0 place-items-center rounded-full bg-action-soft text-action">
        <%= icon(:cloud_rain) %>
      </span>
      <span class="min-w-0 flex-1">
        <%= t(
          ".rain.#{rainfall.effect}",
          names: names_sentence(@rain[:names]),
          when: t(rainfall.fell_on == Time.zone.today ? ".rain.today" : ".rain.yesterday")
        ) %>
        <%= link_to t(".rain.see_journal"), journal_path, class: "font-semibold text-action underline" %>
      </span>
    </p>
  <% end %>
  <% if @has_plants %>
    <% if @due_today.any? %>
      <%= render TaskListComponent.new(
        occurrences: @due_today,
        title: t(".due_today", count: @due_today.size),
        id: "due-today"
      ) %>
    <% else %>
      <%# Nothing left today: said clearly, with what was done and what comes next, so that the screen never looks
          empty by mistake. %>
      <section class="rounded-2xl bg-surface px-4 py-8 text-center" aria-labelledby="due-today">
        <span class="mx-auto grid size-14 place-items-center rounded-full bg-action-soft text-action">
          <%= icon(:check, size: 28) %>
        </span>
        <h2 id="due-today" class="mt-3 text-lg font-semibold"><%= t(".nothing_due") %></h2>
        <p class="mt-1 text-sm text-muted">
          <%= @done_today.any? ? t(".done_today", count: @done_today.size) : t(".all_good") %>
        </p>
        <% if @upcoming.empty? && @next_occurrence %>
          <% task = @next_occurrence.task %>
          <p class="mt-1 text-sm text-muted">
            <%= t(".next_task", what: task.watering? ? t(".water_plant", name: task.subject.name) : task.title) %>
            <%= render DueLabelComponent.new(due_at: @next_occurrence.due_at) %>
          </p>
        <% end %>
        <%= link_to t(@done_today.any? ? ".see_journal" : ".see_plants"),
              @done_today.any? ? journal_path : plants_path,
              class: "mt-4 #{button_class(:secondary)}" %>
      </section>
    <% end %>

    <% if @done_today.any? %>
      <details id="done-today">
        <summary class="cursor-pointer py-3 font-semibold"><%= t(".done_today_list", count: @done_today.size) %></summary>
        <ul class="divide-y divide-line overflow-hidden rounded-2xl bg-surface">
          <% @done_today.each do |entry| %>
            <li><%= render JournalEntryComponent.new(entry:, user: Current.user) %></li>
          <% end %>
        </ul>
      </details>
    <% end %>

    <%# Ids: a morph refresh keeps each list open or folded as the user left it, even when the other one appears. %>
    <% if @upcoming.any? %>
      <details id="upcoming">
        <summary class="cursor-pointer py-3 font-semibold"><%= t(".upcoming", count: @upcoming.size) %></summary>
        <ul class="divide-y divide-line overflow-hidden rounded-2xl bg-surface">
          <% @upcoming.each do |occurrence| %>
            <% task = occurrence.task %>
            <li class="flex min-h-12 items-center justify-between gap-3 px-3 py-2 text-sm">
              <%
                label = if task.watering?
                  t(".water_plant", name: task.subject.name)
                elsif task.subject
                  t(".task_of", title: task.title, name: task.subject.name)
                else
                  task.title
                end
              %>
              <span><%= label %></span>
              <span class="shrink-0 text-muted"><%= render DueLabelComponent.new(due_at: occurrence.due_at) %></span>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  <% else %>
    <%= render EmptyStateComponent.new(icon: :sprout, title: t(".empty_title"), text: t(".empty_body")) do %>
      <% if policy(Plant.new(household: @household)).create? %>
        <%= link_to t(".add"), new_plant_path, class: button_class(:secondary) %>
      <% end %>
    <% end %>
  <% end %>
</div>