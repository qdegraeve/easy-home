<div class="flex items-end justify-between gap-3">
  <div>
    <%= link_to @household.name, households_path,
          class: "text-xs font-semibold uppercase tracking-wide text-emerald-700 underline-offset-2 hover:underline" %>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  </div>
  <% if policy(@household).edit? %>
    <%= link_to t(".house"), edit_household_path(@household), class: "rounded-xl bg-white px-3 py-2 text-sm shadow-sm" %>
  <% end %>
</div>

<div class="mt-6 rounded-2xl bg-white p-6 text-center shadow-sm">
  <p class="text-4xl" aria-hidden="true">🪴</p>
  <p class="mt-2 font-semibold"><%= t(".empty_title") %></p>
  <p class="mt-1 text-sm text-stone-500"><%= t(".empty_body") %></p>
</div>