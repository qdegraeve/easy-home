<% content_for :head do %>
  <%# A completion redirects here: morph the page and keep the scroll, so that the list does not jump. %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>

<div class="flex items-end justify-between gap-3">
  <div>
    <%= link_to @household.name, households_path,
          class: "text-xs font-semibold uppercase tracking-wide text-action underline-offset-2 hover:underline" %>
    <h1 class="text-2xl font-bold"><%= page_title t(".title") %></h1>
  </div>
  <% if policy(@household).edit? %>
    <%= link_to heading_with_icon(:house, t(".house")), edit_household_path(@household),
          class: button_class(:secondary) %>
  <% end %>
</div>

<% can_add = policy(Plant.new(household: @household)).create? %>

<% if @plants.empty? %>
  <div class="mt-6">
    <%= render EmptyStateComponent.new(icon: :sprout, title: t(".empty_title"), text: t(".empty_body")) %>
  </div>
<% else %>
  <div class="mt-6 space-y-6 lg:grid lg:grid-cols-2 lg:gap-6 lg:space-y-0">
    <div class="space-y-6 self-start">
      <%= render TaskListComponent.new(
        occurrences: @due_today,
        title: t(".due_today", count: @due_today.size),
        id: "due-today",
        empty: (t(".nothing_due") if @due_today.empty?)
      ) %>

      <% if @upcoming.any? %>
        <details>
          <summary class="cursor-pointer py-3 font-semibold"><%= t(".upcoming", count: @upcoming.size) %></summary>
          <ul class="divide-y divide-line overflow-hidden rounded-2xl bg-surface">
            <% @upcoming.each do |occurrence| %>
              <% task = occurrence.task %>
              <li class="flex min-h-12 items-center justify-between gap-3 px-3 py-2 text-sm">
                <%
                  label = if task.watering?
                    t(".water_plant", name: task.subject.name)
                  elsif task.subject
                    t(".task_of", title: task.title, name: task.subject.name)
                  else
                    task.title
                  end
                %>
                <span><%= label %></span>
                <span class="shrink-0 text-muted"><%= render DueLabelComponent.new(due_at: occurrence.due_at) %></span>
              </li>
            <% end %>
          </ul>
        </details>
      <% end %>
    </div>

    <section aria-labelledby="all-plants">
      <h2 id="all-plants" class="font-semibold"><%= t(".all", count: @plants.size) %></h2>
      <% @plants.group_by(&:location).sort_by { |location, _| location&.name.to_s }.each do |location, plants| %>
        <% place = safe_join([ location.name, exposure_label(location.exposure) ], " · ") if location %>
        <%= render ListGroupComponent.new(title: place || t(".no_location"), heading: :h3) do |group| %>
          <% plants.each do |plant| %>
            <% group.with_row do %>
              <%= link_to plant, class: "flex min-h-12 items-center justify-between gap-3 px-3 py-2" do %>
                <span class="font-medium"><%= plant.name %></span>
                <% if plant.next_watering_at %>
                  <span class="text-sm text-muted">
                    <%= render DueLabelComponent.new(due_at: plant.next_watering_at) %>
                  </span>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </section>
  </div>
<% end %>

<% if can_add %>
  <%= link_to t(".add"), new_plant_path, class: "mt-6 #{button_class(:primary, block: true)}" %>
<% end %>

<% if @archived_plants.any? %>
  <details class="mt-6">
    <summary class="cursor-pointer py-3 text-sm text-muted">
      <%= t(".archived", count: @archived_plants.size) %>
    </summary>
    <ul class="mt-2 divide-y divide-line overflow-hidden rounded-2xl bg-surface">
      <% @archived_plants.each do |plant| %>
        <li><%= link_to plant.name, plant, class: "flex min-h-12 items-center px-3 text-muted" %></li>
      <% end %>
    </ul>
  </details>
<% end %>

<%= render "shared/account_nav" %>