<div class="flex items-end justify-between gap-3">
  <div>
    <%= link_to @household.name, households_path,
          class: "text-xs font-semibold uppercase tracking-wide text-action underline-offset-2 hover:underline" %>
    <h1 class="text-2xl font-bold"><%= page_title t(".title") %></h1>
  </div>
  <% if policy(@household).edit? %>
    <%= link_to heading_with_icon(:house, t(".house")), edit_household_path(@household),
          class: "rounded-xl bg-surface px-3 py-2 text-sm shadow-sm" %>
  <% end %>
</div>

<% can_add = policy(Plant.new(household: @household)).create? %>

<% if @plants.empty? %>
  <div class="mt-6 rounded-2xl bg-surface p-6 text-center shadow-sm">
    <%= icon(:sprout, size: 32, class: "mx-auto text-muted") %>
    <p class="mt-2 font-semibold"><%= t(".empty_title") %></p>
    <p class="mt-1 text-sm text-muted"><%= t(".empty_body") %></p>
  </div>
<% else %>
  <div class="mt-6 space-y-6 lg:grid lg:grid-cols-2 lg:gap-6 lg:space-y-0">
    <section class="self-start" aria-labelledby="due-today">
      <h2 id="due-today" class="font-semibold"><%= t(".due_today", count: @due_today.size) %></h2>
      <% if @due_today.any? %>
        <ul class="mt-2 divide-y divide-line rounded-2xl bg-surface shadow-sm">
          <% @due_today.each do |occurrence| %>
            <% task = occurrence.task %>
            <li class="flex items-center justify-between gap-3 p-3">
              <div>
                <%= link_to task.subject.name, task.subject, class: "font-medium" %>
                <p class="text-sm text-muted">
                  <%= task.watering? ? t(".watering") : task.title %> ·
                  <%= render DueLabelComponent.new(due_at: occurrence.due_at) %>
                </p>
              </div>
              <%= render "tasks/complete_button", occurrence: %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-2 rounded-2xl bg-surface p-4 text-sm text-muted shadow-sm"><%= t(".nothing_due") %></p>
      <% end %>
    </section>

    <section aria-labelledby="all-plants">
      <h2 id="all-plants" class="font-semibold"><%= t(".all", count: @plants.size) %></h2>
      <% @plants.group_by(&:location).sort_by { |location, _| location&.name.to_s }.each do |location, plants| %>
        <h3 class="mt-3 text-sm text-muted">
          <% if location %>
            <%= location.name %> · <%= exposure_label(location.exposure) %>
          <% else %>
            <%= t(".no_location") %>
          <% end %>
        </h3>
        <ul class="mt-1 divide-y divide-line rounded-2xl bg-surface shadow-sm">
          <% plants.each do |plant| %>
            <li class="flex items-center justify-between gap-3 p-3">
              <%= link_to plant.name, plant, class: "font-medium" %>
              <% if plant.next_watering_at %>
                <span class="text-sm text-muted">
                  <%= render DueLabelComponent.new(due_at: plant.next_watering_at) %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>
<% end %>

<% if can_add %>
  <%= link_to t(".add"), new_plant_path,
        class: "mt-6 block rounded-xl bg-action py-3 text-center font-semibold text-white" %>
<% end %>

<% if @archived_plants.any? %>
  <details class="mt-6">
    <summary class="cursor-pointer text-sm text-muted"><%= t(".archived", count: @archived_plants.size) %></summary>
    <ul class="mt-2 divide-y divide-line rounded-2xl bg-surface shadow-sm">
      <% @archived_plants.each do |plant| %>
        <li class="p-3"><%= link_to plant.name, plant, class: "text-muted" %></li>
      <% end %>
    </ul>
  </details>
<% end %>

<%= render "shared/account_nav" %>