<div class="mx-auto max-w-2xl">
  <%= back_link_to t(".back"), settings_path %>
  <h1 class="mt-2 text-2xl font-bold" data-screen-title><%= page_title t(".title") %></h1>
  <p class="mt-1 text-sm text-muted"><%= t(".intro") %></p>

  <%# Saved on each change (autosave): a toast says it, the form stays as set. %>
  <%= form_with model: @form, url: notification_settings_path, method: :patch, class: "mt-6 space-y-6",
        data: { controller: "autosave", action: "change->autosave#save turbo:submit-end->autosave#sent" } do |f| %>
    <%= render "shared/errors", record: @form %>

    <label class="flex items-center gap-3">
      <%= f.check_box :digest_enabled, class: "h-5 w-5 rounded" %>
      <span class="font-semibold"><%= t(".digest_enabled") %></span>
    </label>

    <%# A refinement of the digest: under it, lighter. %>
    <label class="-mt-3 flex items-start gap-3 pl-8">
      <%= f.check_box :critical_only, class: "mt-0.5 h-5 w-5 rounded" %>
      <span>
        <span class="block"><%= t(".critical_only") %></span>
        <span class="block text-sm text-muted"><%= t(".critical_only_help") %></span>
      </span>
    </label>

    <div>
      <%= f.label :digest_time, class: "block text-sm font-semibold" %>
      <%= f.select :digest_time, NotificationSettingsForm.times, {},
            class: "mt-1 w-32 rounded-xl border border-field bg-surface px-3 py-3" %>
    </div>

    <% if @form.memberships.many? %>
      <fieldset>
        <legend class="text-sm font-semibold"><%= t(".households") %></legend>
        <ul class="mt-2 space-y-2">
          <% @form.memberships.each do |membership| %>
            <li>
              <label class="flex items-center gap-3">
                <%= check_box_tag "notification_settings[household_ids][]", membership.household_id,
                      @form.household_ids.include?(membership.household_id),
                      id: "household_#{membership.household_id}", class: "h-5 w-5 rounded" %>
                <span><%= membership.household.name %></span>
              </label>
            </li>
          <% end %>
        </ul>
      </fieldset>
    <% else %>
      <% @form.memberships.each do |membership| %>
        <%= hidden_field_tag "notification_settings[household_ids][]", membership.household_id,
              id: "household_#{membership.household_id}" %>
      <% end %>
    <% end %>

    <%= f.submit t(".submit"), class: button_class(:primary, block: true), data: { autosave_target: "submit" } %>
  <% end %>

  <section class="mt-8 rounded-2xl bg-surface p-4 text-sm" aria-labelledby="devices">
    <h2 id="devices" class="font-semibold"><%= t(".devices") %></h2>
    <% if (count = Current.user.push_devices.count).positive? %>
      <p class="mt-1"><%= t(".devices_count", count:) %></p>
      <%= button_to t(".test"), test_notification_path, class: "mt-3 #{button_class(:secondary)}" %>
    <% else %>
      <%# Said differently in the app (this phone) and in a browser (the app is needed). %>
      <p class="mt-1 text-muted"><%= t(hotwire_native_app? ? ".no_device_app" : ".no_device_web") %></p>
    <% end %>
  </section>
</div>
