<%= back_link_to t(".back"), house_path %>
<h1 class="mt-2 text-2xl font-bold"><%= page_title t(".title") %></h1>

<div class="mt-6 space-y-6 lg:grid lg:grid-cols-2 lg:gap-6 lg:space-y-0">
  <section class="space-y-3 self-start rounded-2xl bg-surface p-4 shadow-sm">
    <h2 class="font-semibold"><%= heading_with_icon(:map_pin, t(".situation")) %></h2>
    <p class="text-sm text-muted"><%= t(".situation_help") %></p>

    <%= form_with(
      model: @household,
      class: "space-y-3",
      data: { controller: "address-autocomplete", address_autocomplete_url_value: address_suggestions_path }
    ) do |form| %>
      <%= render "shared/errors", record: @household %>

      <div class="relative">
        <%= form.label :address, class: "block text-sm font-semibold" %>
        <%= form.text_field(
          :address,
          autocomplete: "off",
          placeholder: t(".address_placeholder"),
          class: "mt-1 w-full rounded-xl border border-field px-3 py-3",
          data: { address_autocomplete_target: "input", action: "input->address-autocomplete#search" }
        ) %>
        <div data-address-autocomplete-target="results"></div>
      </div>
      <%= form.hidden_field :latitude, data: { address_autocomplete_target: "latitude" } %>
      <%= form.hidden_field :longitude, data: { address_autocomplete_target: "longitude" } %>

      <div>
        <%= form.label :altitude_m, class: "block text-sm font-semibold" %>
        <div class="mt-1 flex items-center gap-2">
          <%= form.number_field(
            :altitude_m,
            class: "w-28 rounded-xl border border-field px-3 py-3",
            data: { address_autocomplete_target: "altitude" }
          ) %>
          <span class="text-sm"><%= t(".meters") %></span>
        </div>
        <p class="mt-1 text-xs text-muted">
          <%= @household.located? && @household.altitude_m.nil? ? t(".altitude_unknown") : t(".altitude_help") %>
        </p>
      </div>

      <%= form.submit t(".save"), class: "w-full rounded-xl bg-action py-3 font-semibold text-white" %>
    <% end %>
  </section>

  <section class="space-y-3">
    <h2 class="font-semibold"><%= heading_with_icon(:sprout, t(".locations")) %></h2>

    <% locations = @household.locations.includes(:plants).order(:name) %>
    <% if locations.any? %>
      <ul class="divide-y divide-line rounded-2xl bg-surface shadow-sm">
        <% locations.each do |location| %>
          <li class="flex items-center justify-between gap-3 p-3">
            <%= link_to edit_location_path(location), aria: { label: t(".edit_label", name: location.name) },
                  class: "min-w-0 flex-1" do %>
              <p class="font-medium"><%= location.name %></p>
              <p class="text-sm text-muted">
                <%= exposure_label(location.exposure) %> ·
                <% if location.sheltered? %>
                  <%= icon(:shield, size: 16) %> <%= t(".sheltered") %>
                <% else %>
                  <%= t(".exposed") %>
                <% end %>
                <% if location.rain_exposed? %>
                  · <%= icon(:cloud_rain, size: 16) %> <%= t(".rain_exposed") %>
                <% end %>
              </p>
            <% end %>
            <%= icon(:chevron_right, class: "text-muted") %>
            <%= button_to(
              t(".delete"),
              location_path(location),
              method: :delete,
              aria: { label: t(".delete_label", name: location.name) },
              form: {
                data: confirm_data(
                  t(".delete_confirm", name: location.name, count: location.plants.size),
                  button: t(".delete"),
                  danger: true
                )
              },
              class: "rounded-xl px-3 py-2 text-sm text-alert hover:bg-alert-soft"
            ) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="rounded-2xl bg-surface p-4 text-sm text-muted shadow-sm"><%= t(".no_locations") %></p>
    <% end %>

    <%= form_with model: [ @household, @location ], class: "space-y-3 rounded-2xl bg-surface p-4 shadow-sm" do |form| %>
      <h3 class="font-semibold"><%= t(".new_location") %></h3>
      <%= render "locations/fields", form: %>

      <%= form.submit t(".add_location"), class: button_class(:primary, block: true) %>
    <% end %>
  </section>
</div>