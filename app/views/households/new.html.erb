<div class="mx-auto max-w-sm">
  <h1 class="text-2xl font-bold" data-screen-title><%= page_title t(".title") %></h1>
  <p class="mt-1 text-sm text-muted"><%= t(".intro") %></p>

  <%= form_with model: @household, class: "mt-6 space-y-4" do |form| %>
    <% if @household.errors.any? %>
      <ul role="alert" class="rounded-xl bg-alert-soft px-4 py-3 text-sm text-alert">
        <% @household.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <%= form.label :name, class: "block text-sm font-semibold" %>
    <%= form.text_field(
      :name,
      required: true,
      autofocus: true,
      placeholder: t(".name_placeholder"),
      class: "w-full rounded-xl border border-field bg-surface px-3 py-3"
    ) %>
    <%= form.submit t(".submit"), class: "w-full rounded-xl bg-action py-3 font-semibold text-white" %>
  <% end %>
</div>

<%= render "shared/account_nav" %>