<h1 class="text-2xl font-bold"><%= t(".title") %></h1>

<ul class="mt-6 divide-y divide-stone-100 rounded-2xl bg-white shadow-sm">
  <% @households.each do |household| %>
    <li class="flex items-center justify-between gap-3 p-4">
      <span class="font-medium"><%= household.name %></span>
      <% if household == @current_household %>
        <span class="text-sm font-semibold text-emerald-700"><%= t(".current") %></span>
      <% else %>
        <%= button_to t(".select"), household_selection_path(household),
              class: "rounded-xl bg-stone-100 px-3 py-2 text-sm font-semibold" %>
      <% end %>
    </li>
  <% end %>
</ul>

<%= link_to t(".new"), new_household_path,
      class: "mt-4 block rounded-xl border-2 border-dashed border-emerald-400 py-3 text-center font-semibold text-emerald-800" %>