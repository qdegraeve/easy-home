<h1 class="text-2xl font-bold"><%= page_title t(".title") %></h1>

<%= render ListGroupComponent.new do |group| %>
  <% @households.each do |household| %>
    <% group.with_row do %>
      <div class="flex min-h-14 items-center justify-between gap-3 px-3 py-2">
        <span>
          <span class="block font-medium"><%= household.name %></span>
          <span class="text-sm text-muted"><%= t(".roles.#{@roles[household.id]}") %></span>
        </span>
        <% if household == @current_household %>
          <span class="text-sm font-semibold text-action"><%= t(".current") %></span>
        <% else %>
          <%= button_to t(".select"), household_selection_path(household), class: button_class(:secondary) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= link_to t(".new"), new_household_path, class: "mt-4 #{button_class(:tertiary, block: true)}" %>