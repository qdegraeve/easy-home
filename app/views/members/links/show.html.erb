<div class="mx-auto max-w-2xl">
  <%= back_link_to t(".back"), members_path %>
  <h1 class="mt-2 text-2xl font-bold" data-screen-title><%= page_title t(".title") %></h1>

  <section class="mt-6 space-y-4 rounded-2xl bg-surface p-4">
    <% if @token %>
      <% url = invitation_url(@token) %>
      <p><%= t(".intro", name: @member.invitee_name || t("members.index.unnamed")) %></p>
      <p class="break-all rounded-xl bg-subtle p-3 font-mono text-sm" data-invitation-link><%= url %></p>
      <div class="grid grid-cols-2 gap-3">
        <button type="button" class="<%= button_class(:secondary) %>"
                data-controller="clipboard" data-clipboard-text-value="<%= url %>"
                data-clipboard-done-value="<%= t(".copied") %>" data-action="clipboard#copy"><%= t(".copy") %></button>
        <button type="button" class="<%= button_class(:primary) %>"
                data-controller="share bridge--share"
                data-share-text-value="<%= t(".share_text", household: @member.household.name, url:) %>"
                data-action="share#share share:native->bridge--share#share"><%= t(".share") %></button>
      </div>
      <p class="text-sm text-muted">
        <%= t(".validity", date: l(@member.invitation.expires_at.to_date, format: :day)) %>
      </p>
    <% else %>
      <p><%= t(".gone") %></p>
      <%= button_to t(".renew"), member_link_path(@member), class: button_class(:primary, block: true) %>
    <% end %>
  </section>
</div>
