<% if @suggestions.any? %>
  <ul class="absolute left-0 right-0 z-10 mt-1 divide-y divide-stone-100 rounded-xl border border-stone-200 bg-white text-sm shadow-lg">
    <% @suggestions.each do |suggestion| %>
      <li>
        <button
          type="button"
          class="w-full px-3 py-3 text-left hover:bg-stone-50"
          data-action="address-autocomplete#select"
          data-label="<%= suggestion.label %>"
          data-latitude="<%= suggestion.latitude %>"
          data-longitude="<%= suggestion.longitude %>"
        ><%= suggestion.label %></button>
      </li>
    <% end %>
  </ul>
<% end %>