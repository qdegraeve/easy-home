<% if @suggestions.any? %>
  <ul
    class="absolute left-0 right-0 z-10 mt-1 divide-y divide-line rounded-xl border border-line bg-surface text-sm
           shadow-lg"
  >
    <% @suggestions.each do |suggestion| %>
      <li>
        <button
          type="button"
          class="w-full px-3 py-3 text-left hover:bg-subtle"
          data-action="address-autocomplete#select"
          data-label="<%= suggestion.label %>"
          data-latitude="<%= suggestion.latitude %>"
          data-longitude="<%= suggestion.longitude %>"
        ><%= suggestion.label %></button>
      </li>
    <% end %>
  </ul>
<% end %>