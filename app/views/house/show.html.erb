<h1 class="text-2xl font-bold"><%= page_title t(".title") %></h1>
<p class="text-sm text-muted"><%= @household.name %></p>

<div class="mt-6 space-y-6 lg:max-w-2xl">
  <%= render ListGroupComponent.new(title: t(".inventory"), id: "inventory") do |group| %>
    <% group.with_row do %>
      <%= link_to plants_path, class: "flex min-h-14 items-center gap-3 px-3 py-2" do %>
        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-subtle text-plants">
          <%= icon(:sprout) %>
        </span>
        <span class="flex-1">
          <span class="block font-medium"><%= t(".plants") %></span>
          <span class="text-sm text-muted"><%= t(".plants_count", count: @plants_count) %></span>
        </span>
        <%= icon(:chevron_right, class: "text-muted") %>
      <% end %>
    <% end %>
  <% end %>
  <p class="-mt-3 px-1 text-sm text-muted"><%= t(".more_soon") %></p>

  <% if policy(@household).edit? %>
    <%= render ListGroupComponent.new(title: t(".places"), id: "places") do |group| %>
      <% group.with_row do %>
        <%= link_to edit_household_path(@household), class: "flex min-h-14 items-center gap-3 px-3 py-2" do %>
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-subtle text-muted">
            <%= icon(:map_pin) %>
          </span>
          <span class="flex-1">
            <span class="block font-medium"><%= t(".address_and_locations") %></span>
            <span class="text-sm text-muted">
              <%= @household.address.presence || t(".no_address") %> ·
              <%= t(".locations_count", count: @locations_count) %>
            </span>
          </span>
          <%= icon(:chevron_right, class: "text-muted") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>