<%# Adding a photo in one gesture, to a plant, an equipment or a task (url: where it is sent; floating: in the app,
    the floating button of a page whose main action it is). The button opens the camera or the gallery, the photo is
    sent once chosen. In the Android app, a floating button stays in the page: the web view opens a file chooser only
    on a tap of the user in the page, never on a click asked by the app. %>
<%= form_with model: PhotoUpload.new, url:, class: "mt-3",
              data: { controller: "photo-picker" } do |f| %>
  <%= f.label :file, t("photos.picker.new_photo"), class: "sr-only" %>
  <%# Hidden from screen readers too: the button below is the way to choose. %>
  <%= f.file_field :file, accept: "image/*", required: true, class: "sr-only", tabindex: -1, aria: { hidden: true },
        data: { photo_picker_target: "input", action: "photo-picker#chosen" } %>
  <% if floating && hotwire_native_app? %>
    <%= button_tag type: "button", aria: { label: t("photos.picker.add_photo") }, data: { floating_action: true,
                   action: "photo-picker#choose", photo_picker_target: "button" },
          class: "fixed bottom-4 right-4 z-20 inline-flex h-14 items-center gap-2 rounded-2xl bg-action px-5 " \
                 "font-semibold text-white shadow-lg" do %>
      <%= icon(:plus, size: 22) %><%= t("photos.picker.add_photo_label") %>
    <% end %>
  <% else %>
    <%= button_tag type: "button", class: button_class(:secondary, block: true),
          data: { action: "photo-picker#choose", photo_picker_target: "button" } do %>
      <%= icon(:camera) %><%= t("photos.picker.add_photo") %>
    <% end %>
  <% end %>
<% end %>