SECRETS=$(kamal secrets fetch --adapter bitwarden-sm 3626f3e2-844e-4175-ab19-b50d0088d16f/all)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
TUNNEL_TOKEN=$(kamal secrets extract TUNNEL_TOKEN ${SECRETS})
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD ${SECRETS})
POSTGRES_USER=$(kamal secrets extract POSTGRES_USER ${SECRETS})
RESTIC_REPOSITORY=$(kamal secrets extract RESTIC_REPOSITORY ${SECRETS})
RESTIC_PASSWORD=$(kamal secrets extract RESTIC_PASSWORD ${SECRETS})
R2_ACCESS_KEY_ID=$(kamal secrets extract R2_ACCESS_KEY_ID ${SECRETS})
R2_SECRET_ACCESS_KEY=$(kamal secrets extract R2_SECRET_ACCESS_KEY ${SECRETS})
BACKUP_HEALTHCHECK_URL=$(kamal secrets extract BACKUP_HEALTHCHECK_URL ${SECRETS})


# PostgreSQL password: provide it through the environment or a password manager
# (ex. POSTGRES_PASSWORD=$(op read "op://Private/easy-home-db/password")).
DB_USER=$POSTGRES_USER
DB_PASSWORD=$POSTGRES_PASSWORD
